# Python bytecode and cache directories.
__pycache__/
*.py[cod]
*.pyo

# pytest cache.
.pytest_cache/

# Coverage reports.
.coverage
htmlcov/

# PyInstaller build artifacts.
build/
dist/
*.spec

# PyArmor output directories (should be chosen explicitly by the user).
# Do not ignore "obfuscated/" here; users may name their output anything.

# Virtual environments.
.venv/
venv/
env/

# Distribution packaging.
*.egg-info/
dist/

# PyShield per-build HMAC secret files.
# These files contain the secret key used to sign licenses.  They must NEVER
# be committed to source control.  Each build generates its own secret file.
# Committing this file would expose the key and allow anyone who reads the
# repository to forge valid license files for any binary built with this key.
.pyshield_secret
dist/.pyshield_secret

# PyShield runtime constants file.
# This file is generated by 'pyshield build' just before PyArmor obfuscation
# and contains the HMAC key as a Python literal.  It is deleted after
# obfuscation completes, but we list it here as a safety net in case the
# build is interrupted before cleanup runs.
**/_pyshield_runtime_constants.py
